# Copy to .env and adjust. Never commit .env.
# Values below are development defaults and are not secrets.

# Application
AGENTRANK_ENV=development
AGENTRANK_LOG_LEVEL=info

# PostgreSQL, matching docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentrank
POSTGRES_USER=agentrank
POSTGRES_PASSWORD=agentrank_dev_password

# Frontend. Read on the Next.js server only, so it is not exposed to the browser.
AGENTRANK_API_BASE_URL=http://localhost:8000

# Razorpay Test Mode. Placeholders only. Real keys belong in .env, which is never committed.
# The key id must begin rzp_test_. A live key is refused at startup: this project has no live
# mode, and no request field, flag or variable relaxes that.
# The key secret is never sent to the browser, never logged and never written to an audit
# payload. The key id is public and is returned where Standard Checkout requires it.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# The console needs a merchant API key to call the AgentRank API on the server side. Issue one
# with `make credentials ARGS="issue --merchant-slug <slug> --label console"`.
AGENTRANK_MERCHANT_API_KEY=ar_dev_replace_me

# Runtime LLM providers. Real values belong only in untracked .env. The isolated benchmark worker
# receives exactly the selected provider credential, never both.
OPENAI_API_KEY=
GEMINI_API_KEY=
