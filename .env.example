# Copy to .env and adjust. Never commit .env.
# Values below are development defaults and are not secrets.

# Application
AGENTRANK_ENV=development
AGENTRANK_LOG_LEVEL=info

# PostgreSQL, matching docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentrank
POSTGRES_USER=agentrank
POSTGRES_PASSWORD=agentrank_dev_password

# Frontend. Read on the Next.js server only, so it is not exposed to the browser.
AGENTRANK_API_BASE_URL=http://localhost:8000

# Required by the console. Every browser session credential is derived from this by HMAC, so a
# console started without one refuses to boot and naming it is the whole of the failure message.
# At least 32 characters. Generate with `openssl rand -hex 32`.
#
# Two consequences worth knowing before you change it. Every console process serving the same
# deployment must have the same value, or a session opened by one is not resolvable by another.
# And changing it signs every merchant out at once, which is also how you sign every merchant out
# at once if you ever need to.
AGENTRANK_CONSOLE_SESSION_SECRET=replace_me_with_openssl_rand_hex_32

# Local HTTP development only. Session cookies are Secure unless this is exactly "false", which
# is what lets a console on plain http://localhost hold a session at all. Never set in a real
# deployment: it puts the session cookie on the wire in the clear.
# AGENTRANK_COOKIE_SECURE=false

# Razorpay Test Mode. Placeholders only. Real keys belong in .env, which is never committed.
# The key id must begin rzp_test_. A live key is refused at startup: this project has no live
# mode, and no request field, flag or variable relaxes that.
# The key secret is never sent to the browser, never logged and never written to an audit
# payload. The key id is public and is returned where Standard Checkout requires it.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# The console holds no merchant API key. A merchant signs in with theirs, the console exchanges
# it for a session and forgets it, and there is no environment credential anywhere that could
# stand in for a signed in merchant. Issue a merchant a key with
# `make credentials ARGS="create --merchant-slug <slug> --label console"` and hand it to them.

# Runtime LLM providers. Real values belong only in untracked .env. The isolated benchmark worker
# receives exactly one credential for the selected provider, never the other provider's.
#
# Either variable may list several keys separated by commas, each from a different provider
# project. The dispatcher hands one key to each mission's worker process and moves to the next
# key for the next mission, which spreads a per-minute rate limit across projects rather than
# draining one, and a mission the provider refused before the buyer touched the merchant is
# retried with the next key. Brackets or quotes around the list are tolerated: [a, b, c] and
# a,b,c are the same three keys.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Networks the merchant page importer may reach in addition to the public internet, as a comma
# separated list of CIDR blocks. Local development and the test suite only: it is what lets an
# import reach a synthetic storefront served on loopback.
#
# A process refuses to start with this set unless AGENTRANK_ENV is present in its own environment
# and names development, ci or test. Present, not merely defaulted: AGENTRANK_ENV defaults to
# development, and an absence must never be what authorises reaching a private network from a URL
# a request body chose. Setting it in this file is not enough for the same reason, because
# AGENTRANK_ENV is the one variable a file may not decide.
#
#   AGENTRANK_ENV=development AGENTRANK_IMPORT_ALLOWED_NETWORKS=127.0.0.0/8 make api
#
# AGENTRANK_IMPORT_ALLOWED_NETWORKS=127.0.0.0/8
